<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wd_widget_bg" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT UP" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="#FF6B7078" />
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:textColor="#FF1B1D21" android:maxLines="2" android:ellipsize="end" android:text="Nothing coming up" />
    <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFE5483C" android:maxLines="1" android:text="" />
    <Chronometer android:id="@+id/w_chrono" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFE5483C" android:visibility="gone" />
    <TextView android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF6B7078" android:maxLines="2" android:ellipsize="end" android:text="" />
</LinearLayout>