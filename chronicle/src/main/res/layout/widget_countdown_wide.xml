<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/wd_widget_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:gravity="center_vertical">
    <TextView android:id="@+id/w_big" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textStyle="bold" android:textColor="#FFE5483C" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
    <Chronometer android:id="@+id/w_chrono" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textStyle="bold" android:textColor="#FFE5483C" android:maxLines="1" android:visibility="gone"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="#FF6B7078" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FF1B1D21" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FF6B7078" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
